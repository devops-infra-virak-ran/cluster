# Platform facts are NOT committed. They name a live environment — account id,
# load balancer, bastion and node addresses — and this repository is public.
#
# Get them from whoever provisions the machines (they come from
# `terraform output`). platform/<ws>.env.example lists every key.
platform/*.env

# Rendered by `make graph`.
graph.svg

# Rendered ArgoCD Applications carry the ECR prefix (account id) — not committed.
argocd/application-*.yaml
