# Generated by `make apply` — one directory per Terraform workspace, holding
# the inventory Terraform rendered and whatever the playbooks leave behind.
#
# artifacts/admin.conf is a cluster-admin credential. It must never be
# committed; that is the main reason this whole tree is ignored rather than
# just the inventory file.
inventory/

# Host keys accepted by the bastion hop, kept so they are accepted once.
.known_hosts
