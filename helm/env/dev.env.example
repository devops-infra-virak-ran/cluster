# Application variables for the dev cluster.
#
#   cp helm/env/dev.env.example helm/env/dev.env
#   $EDITOR helm/env/dev.env
#   make env-apply WORKSPACE=dev
#
# dev.env is gitignored. This file is the template, and is not — so it must
# never contain a real credential.
#
# Format is literal: everything after the first `=` is the value.
#
#   DB_PASSWORD=s3cr3t          good
#   DB_PASSWORD="s3cr3t"        the quotes end up IN the password
#   export DB_PASSWORD=s3cr3t   the variable is named "export DB_PASSWORD"
#
# So: no quotes, no export, no trailing comments on a value line. URLs, spaces
# and query strings need no escaping.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon requires TLS; without sslmode=require the connection is refused rather
# than downgraded.

DB_HOST=ep-xxxx-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=
DB_SSL=true

# Some clients want one URL instead of the parts above. Set whichever your
# image actually reads — extra variables are harmless.
DATABASE_URL=postgresql://appuser:password@ep-xxxx.us-east-2.aws.neon.tech/appdb?sslmode=require

# ─── Application ─────────────────────────────────────────────────────────────

JWT_SECRET=
NODE_ENV=production
