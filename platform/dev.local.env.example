# Machine-specific overrides for workspace `dev`. Gitignored — yours alone.
#
# Anything in platform/dev.env can be overridden here; this file wins.

# Absolute path, no "~": this is mounted into the Kubespray container at the
# same path, where "~" would resolve to /root.
SSH_PRIVATE_KEY_PATH=/absolute/path/to/your/private/key
