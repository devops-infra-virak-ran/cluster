# Platform facts — the handover from the infrastructure project.
#
# You do not fill this in. Terraform publishes every one of these to SSM
# Parameter Store at /platform/<workspace>/<key> in the apply that changes it,
# and this writes platform/<workspace>.env from there:
#
#   make platform-pull WORKSPACE=dev
#   make platform      WORKSPACE=dev    # every key, its value, which layer answered
#
# The real file is gitignored: it names a live environment (the account id is
# inside the ECR prefix), and this repository is public. This one only lists
# the keys, with the shape of each value.

REGION=us-east-1
CLUSTER_NAME=<project>-<workspace>
VPC_ID=vpc-0123456789abcdef0

# Helm needs the prefix (global.imageRegistry); check-images needs the host.
ECR_IMAGE_PREFIX=<account-id>.dkr.ecr.<region>.amazonaws.com/<project>
ECR_REGISTRY_URL=<account-id>.dkr.ecr.<region>.amazonaws.com

# The role the load balancer controller runs as. Reference only — the pod
# identity association already binds it to kube-system/aws-load-balancer-controller.
LBC_ROLE_ARN=arn:aws:iam::<account-id>:role/<cluster>-aws-load-balancer-controller

# Where the ALB's nodes are, so where pod traffic from it comes from. The team
# NetworkPolicies admit these.
PUBLIC_SUBNET_CIDRS=10.0.1.0/24,10.0.2.0/24

# A team's secret is <SECRETS_NAME_PREFIX>/<team>, read through the role
# <SECRETS_ROLE_PREFIX><team>.
SECRETS_NAME_PREFIX=<project>/<workspace>
SECRETS_ROLE_PREFIX=arn:aws:iam::<account-id>:role/<cluster>-secrets-

# Only when the workspace has a domain.
SITE_URL=https://dev.<domain>
SITE_HOSTNAME=dev.<domain>
CERTIFICATE_ARN=arn:aws:acm:<region>:<account-id>:certificate/<id>
ROUTE53_ZONE_ID=Z0123456789ABCDEFGHIJ
