# Platform facts — the handover from whoever provisions the machines.
#
# Copy this to platform/<workspace>.env and fill in the real values. That file
# is gitignored: it names a live environment, and this repository is public.
#
# The infrastructure repo generates a filled-in copy:
#
#   make platform-env WORKSPACE=dev > platform/dev.env
#
# Check what resolved, and from which layer:
#
#   make platform WORKSPACE=dev

REGION=us-east-1
CLUSTER_NAME=<project>-<workspace>

# Where images are pulled from. Helm needs the prefix; ecr-auth.sh needs the
# bare host, because an imagePullSecret authenticates to a registry rather than
# to a path inside it.
ECR_IMAGE_PREFIX=<account-id>.dkr.ecr.<region>.amazonaws.com/<project>
ECR_REGISTRY_URL=<account-id>.dkr.ecr.<region>.amazonaws.com

# The public front door, and the NodePort it forwards to. INGRESS_NODEPORT must
# match the target group the load balancer was built around, or the health check
# fails on every target and the URL returns 503.
ALB_URL=http://<load-balancer-dns-name>
ALB_DNS_NAME=<load-balancer-dns-name>
INGRESS_NODEPORT=30080

# How to reach the nodes. They have no public addresses, so everything hops
# through the bastion.
BASTION_IP=<bastion-public-ip>
CONTROL_PLANE_IP=<control-plane-private-ip>
NODE_SSH_USER=ubuntu

# SSH_PRIVATE_KEY_PATH is not here. Where your key lives is a fact about your
# machine, so it goes in platform/<workspace>.local.env, also gitignored.
